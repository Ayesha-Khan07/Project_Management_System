<section class="p-10 bg-gray-50 min-h-screen">
  <h1 class="text-3xl font-bold mb-8 text-teal-500">Create New Project</h1>

  <div class="bg-white p-8 rounded-2xl shadow-lg w-full max-w-5xl mx-auto">

    <%= form_with model: @project, local: true, html: { multipart: true } do |f| %>

      <!-- Title -->
      <div class="mb-6">
        <%= f.text_field :title,
          placeholder: "Title",
          class: "w-full border-b-2 border-gray-300 focus:border-teal-500 focus:outline-none
                  text-2xl font-bold placeholder:text-2xl placeholder:font-bold placeholder:text-gray-400 py-2" %>
      </div>

      <!-- Description (Plain Textarea) -->
      <div class="mb-6">
        <label class="block font-semibold mb-2">Description</label>
        <%= f.text_area :description,
              rows: 10,
              placeholder: "Type project description here",
              class: "w-full border rounded px-4 py-4 mt-3 p-3 text-gray-700 focus:outline-none focus:border-teal-500" %>
      </div>

      <!-- Project Status -->
      <div class="mb-6">
        <label class="block font-semibold mb-2">Project Status</label>
        <%= f.select :project_status,
          Project.project_statuses.keys.map { |s| [s.titleize, s] },
          {},
          class: "w-full p-3 border rounded-lg" %>
      </div>

      <!-- Deadline -->
      <div class="mb-6">
        <label class="block font-semibold mb-2">Deadline</label>
        <%= f.date_field :project_deadline, class: "w-full p-3 border rounded-lg" %>
      </div>

      <!-- File Upload -->
      <div class="mb-6">
        <label class="block font-semibold mb-2">Upload Document</label>
        <div class="border-2 border-dashed p-6 rounded-lg text-center bg-gray-100 cursor-pointer">
          <span class="block text-gray-600 mb-3">+ Browse and upload file here</span>
          <%= f.file_field :uploaded_document, class: "block mx-auto" %>
        </div>
      </div>

      <!-- Submit -->
      <div class="mt-8 text-right">
        <%= f.submit "Create Project", class: "px-6 py-3 bg-teal-600 text-white rounded-lg shadow hover:bg-teal-700" %>
      </div>

    <% end %>
  </div>
</section>
