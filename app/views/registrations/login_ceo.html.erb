<div class="max-w-md mx-auto py-16">
  <h2 class="text-2xl font-bold mb-4 text-center">Login your account</h2>

<%= form_with model: @user, url: login_ceo_path, local: true, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
    <%= f.email_field :email, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
    <%= f.password_field :password, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div class="text-center">
    <%= f.submit "Continue to Company Profile", class: "bg-teal-600 text-white px-4 py-2 rounded-lg" %>
  </div>
<% end %>
</div>
