<!-- gradient colors -->
<div class="fixed top-20 left-4 w-92 h-92 bg-teal-300 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse pointer-events-none -z-10"></div>
<div class="fixed bottom-0 right-2 w-92 h-92 bg-teal-200 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse delay-300 pointer-events-none -z-10"></div>

<div class="max-w-md mx-auto py-16">
  <h2 class="text-2xl font-bold mb-4 text-center">
  <span class="italic text-3xl px-3 text-teal-600">Log in</span> your account
  </h2>
  <p class="text-sm text-center text-gray-500 mt-2 mb-5">
        Welcome back! Log in to continue collaborating
  </p>


  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "mt-2 h-10 px-4 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: "mt-2 h-10 px-4 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center">
        <%= f.check_box :remember_me, class: "rounded border-gray-300" %>
        <%= f.label :remember_me, class: "ml-2 text-sm text-gray-700" %>
      </div>
    <% end %>

    <div class="text-center">
      <%= f.submit "Log in", class: "bg-teal-600 mt-4 text-white px-4 py-2 rounded-lg hover:bg-teal-700" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>