<!-- gradient colors -->
  <div class="fixed top-20 left-4 w-92 h-92 bg-teal-300 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse pointer-events-none -z-10"></div>
  <div class="fixed bottom-0 right-2 w-92 h-92 bg-teal-200 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse delay-300 pointer-events-none -z-10"></div>

<div class="max-w-md mx-auto py-16">
  <h2 class="text-3xl font-bold mb-4 text-center">Create your account</h2>
  <p class="text-sm text-center text-gray-500 mt-2 mb-5">
        Join ProjectHub and start collaborating
  </p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :username, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :username, autofocus: true, required: true, class: "mt-2 h-10 px-4 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, maxlength: 50, 
            class: "mt-2 h-10 px-4 block w-full rounded-md border-gray-300 shadow-sm" %>
      <p class="text-xs text-gray-500 mt-2 mb-4">Max 50 characters. Must be a valid email format</p>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, class: "mt-2 h-10 px-4 block w-full rounded-md border-gray-300 shadow-sm" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-gray-500 mt-2 mb-4">(<%= @minimum_password_length %> characters minimum)</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "mt-2 h-10 px-4 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div class="text-center mt-8">
      <%= f.submit "Sign up", class: "bg-teal-600 text-white px-4 py-2 rounded-lg hover:bg-teal-700" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>