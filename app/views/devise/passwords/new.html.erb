<div class="mt-15 flex flex-col justify-center items-center bg-gray-50 px-4">
  <div class="w-full max-w-md bg-white p-8 rounded-lg shadow-md">
    <h2 class="text-2xl font-bold text-gray-800 text-center mb-6">Forgot Your Password?</h2>
    <p class="text-sm text-gray-500 text-center mb-9">
      Enter your email below and we'll send you instructions to reset your password.
    </p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-gray-700 font-semibold mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 mb-4 border rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.submit "Send Reset Instructions", class: "w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-3 rounded-lg transition-colors" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-sm text-gray-500">
      <%= link_to "Back to Login", new_session_path(resource_name), class: "text-teal-600 hover:underline" %>
    </div>
  </div>
</div>

