<!-- gradient colors -->
<div class="fixed top-20 left-4 w-92 h-92 bg-teal-300 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse pointer-events-none -z-10"></div>
<div class="fixed bottom-0 right-2 w-92 h-92 bg-teal-200 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse delay-300 pointer-events-none -z-10"></div>
<div class="fixed -top-20 right-2 w-92 h-92 bg-teal-200 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse delay-300 pointer-events-none -z-10"></div>

<div class=" mt-10 flex flex-col items-center justify-center bg-gray-50 px-4 py-10">
  <div class="w-full max-w-md bg-white rounded-lg shadow-md p-8">
    <h2 class="italic text-2xl font-bold text-teal-700 mb-8 text-center">Change Your Password</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, class: "space-y-6") do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "New Password", class: "block text-gray-700 font-semibold mb-2" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full px-3 py-2 mb-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mb-6">Minimum <%= @minimum_password_length %> characters</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm New Password", class: "block text-gray-700 font-semibold mb-2" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full px-3 py-2 mb-8 border rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" %>
      </div>

      <div>
        <%= f.submit "Change My Password",
              class: "w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-2 px-4 rounded-lg transition" %>
      </div>
    <% end %>

    <div class="mt-5 text-center text-sm  text-gray-500">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>

