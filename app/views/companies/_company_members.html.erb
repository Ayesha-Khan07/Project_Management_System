<div class="mt-2">
  <h2 class="text-2xl font-semibold mb-4 flex items-center gap-2 ml-12">
    <i data-lucide="users" class="w-6 h-6 text-teal-700"></i>
    Active Members (<%= @active_count %>)
  </h2>

  <% if @active_count.positive? %>
    <div class="card-body-custom">
      <div class="table-responsive flex justify-between ml-10 mt-5 mr-5">
        <table class="table modern-table w-full text-center">
          <thead>
            <tr>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
              <th>Projects</th>
              <th>Created At</th>
              <% if can_edit_company?(current_user)%>
                <th>Actions</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% company.users.each do |user| %>
              <tr class="table-row-hover">
                <td><strong><%= user.username %></strong></td>
                <td><%= user.email %></td>
                <td><span class="badge-custom badge-<%= user.role %>"><%= user.role %></span></td>
                <td><%= user.projects.count %></td>
                <td><%= user.created_at.strftime('%B %d, %Y') %></td>
                <td>
                  <% if can_edit_company?(current_user) && !can_edit_company?(user) %>
                    <%= button_to remove_user_company_path(company, user_id: user.id),
                        method: :delete, 
                        form: { onsubmit: "return confirm('Are you sure you want to delete this user?');" },
                        class: 'btn-delete' do %>
                      <i class="bi bi-trash"></i> Delete
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="text-gray-700 mt-2 text-center">No active members.</p>
  <% end %>
</div>
