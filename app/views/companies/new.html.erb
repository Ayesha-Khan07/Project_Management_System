<!-- gradient colors -->
<div class="fixed top-20 left-4 w-92 h-92 bg-teal-300 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse pointer-events-none -z-10"></div>
<div class="fixed bottom-0 right-2 w-92 h-92 bg-teal-200 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse delay-300 pointer-events-none -z-10"></div>
<div class="fixed -top-20 right-2 w-92 h-92 bg-teal-200 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse delay-300 pointer-events-none -z-10"></div>

<div class=" flex items-center justify-center bg-gray-50 px-4 py-16">
  <div class="w-full max-w-2xl bg-white rounded-xl shadow-lg p-10">
    <h2 class="italic text-3xl font-bold mb-2 text-center text-teal-700">Create Company Profile</h2>
    <p class="text-center text-gray-500 mb-8">Add your company details to start managing your company projects</p>

    <%= form_with model: @company, local: true, html: { multipart: true }, class: "space-y-6" do |f| %>
      
      <!-- Company Name -->
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, required: true,
              class: "mt-2 block w-full rounded-lg border border-gray-300 shadow-sm px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500" %>
      </div>

      <!-- Description -->
      <div>
        <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_area :description, rows: 4,
              class: "mt-2 block w-full rounded-lg border border-gray-300 shadow-sm px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500" %>
      </div>

      <!-- Services -->
      <div>
        <%= f.label :services, "Services (comma separated)", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :services,
              class: "mt-2 block w-full rounded-lg border border-gray-300 shadow-sm px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500" %>
      </div>

      <!-- Logo -->
      <div>
        <%= f.label :logo, class: "block text-sm font-medium text-gray-700" %>
        <%= f.file_field :logo, accept: "image/*",
              class: "mt-2 mb-9 block w-full text-gray-600 cursor-pointer border rounded-lg p-2 hover:bg-gray-100 transition" %>
      </div>

      <!-- Submit -->
      <div class="text-center">
        <%= f.submit "Create Company",
              class: "w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold px-4 py-2 rounded-lg transition" %>
      </div>

    <% end %>
  </div>
</div>
