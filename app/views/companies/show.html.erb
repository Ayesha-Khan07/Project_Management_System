<section class="relative overflow-hidden -mt-7 bg-gradient-to-br from-slate-50 via-white to-teal-50">
  <div class="absolute top-0 left-0 w-92 h-92 bg-teal-300 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse pointer-events-none"></div>

  <div class="w-full px-6 md:px-12 py-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
    <%= render 'company_card', company: @company %>

    <div class="md:col-span-2 space-y-8 self-start md:-ml-20">
      <div class="flex md:justify-end">
        <% if can_edit_company?(current_user) %>
          <%= link_to new_project_path, class: "flex items-center mt-6 bg-teal-600 text-white px-4 py-2 rounded-lg shadow hover:bg-teal-700 transition" do %>
            <span class="text-lg font-bold mr-2">+</span> Create Project
          <% end %>
        <% end %>
      </div>

      <%= render 'company_description', company: @company %>
      <%= render 'company_services', company: @company %>
    </div>
  </div>

  <%= render 'company_members', company: @company %>
</section>
