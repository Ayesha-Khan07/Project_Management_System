<div class="w-full px-6 md:px-12 py-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">

  <!-- LEFT CARD -->
  <div class="bg-white shadow-lg rounded-xl p-10 ml-10 relative w-full md:w-100 md:col-span-1 self-start flex flex-col items-center md:items-start">

    <!-- Upgrade Button (top-right) -->
    <a href="#"
       class="absolute top-5 right-6 bg-teal-600 text-white px-3 py-1.5 rounded-full text-sm font-medium hover:bg-teal-700 transition">
      Upgrade
    </a>

    <!-- Company Logo With Camera Icon -->
    <div class="relative w-32 h-32 mt-6 mx-auto">
      <% if @company.logo.attached? %>
        <%= image_tag @company.logo, class: "w-32 h-32 rounded-full object-cover border" %>
      <% else %>
        <div class="w-32 h-32 bg-gray-200 rounded-lg border flex items-center justify-center text-gray-500">
          No Logo
        </div>
      <% end %>

      <!-- Camera Icon for Upload -->
      <label class="absolute bottom-1 right-1.5 bg-gray-500 text-white p-2 rounded-full cursor-pointer hover:bg-gray-700">
        <i data-lucide="camera" class="w-4 h-4"></i>
        <%= form_with model: @company, url: company_path(@company), method: :patch, html: { multipart: true, class: "hidden" } do |f| %>
          <%= f.file_field :logo, onchange: "this.form.submit();" %>
        <% end %>
      </label>
    </div>

    <!-- Company Name & Admin -->
    <div class="mt-4 w-full text-center md:text-center">
      <h1 class="text-2xl font-bold"><%= @company.name %></h1>
      <% admin_user = @company.users.find_by(role: "admin") %>
      <p class="text-gray-600 mt-2 mb-1">Admin: <span class="font-medium"><%= admin_user&.username.titleize || "N/A" %></span></p>
    </div>

    <div class="w-full border-t my-4"></div>

    <!-- Subscription & Member Info -->
    <div class="space-y-4 w-full text-gray-700 text-lg">
      <p><strong class="mr-3">Subscription Status:</strong> <%= @company.subscription_status.titleize || "Free Plan" %></p>
      <p><strong class="mr-4">Member Limit:</strong> <%= @company.member_limit %></p>
      <% active_count = @company.users.count %>
      <p><strong class="mr-3">Active Members:</strong> <%= active_count %></p>
    </div>
  </div>

  <!-- RIGHT SIDE CONTENT -->
  <div class="md:col-span-2 space-y-6 self-start">

    <!-- Create Button -->
    <div class="flex md:justify-end">
      <a href="#"
         class="flex items-center bg-teal-600 text-white px-4 py-2 rounded-lg shadow hover:bg-teal-700 transition">
        <span class="text-lg font-bold mr-2">+</span> Create Project
      </a>
    </div>

    <!-- Company Description -->
    <div>
      <h2 class="text-xl font-semibold mb-2">Company Description</h2>
      <p class="bg-gray-50 p-4 rounded-lg border text-gray-700">
        <%= @company.description.presence || "No description available." %>
      </p>
    </div>

    <!-- Services as Badges -->
    <div>
      <h2 class="text-xl font-semibold mb-2">Services</h2>
      <% if @company.services.present? %>
        <div class="flex flex-wrap gap-2">
          <% @company.services.split(",").each do |service| %>
            <span class="bg-teal-100 text-teal-800 px-3 py-1 rounded-full text-sm font-medium">
              <%= service.strip %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-700">No services listed.</p>
      <% end %>
    </div>

    <!-- Active Members -->
    <div>
      <h2 class="text-xl font-semibold mb-2">Active Members</h2>
      <% if active_count > 0 %>
        <ul class="space-y-3">
          <% @company.users.each do |user| %>
            <li class="flex items-center space-x-3">
              <!-- Avatar -->
              <div class="w-10 h-10 rounded-full bg-gray-300 flex items-center justify-center text-gray-700 font-semibold">
                <%= user.username[0].upcase %>
              </div>

              <!-- Username -->
              <span class="font-medium text-gray-800"><%= user.username.titleize %></span>

              <!-- Admin Badge -->
              <% if user.role == "admin" %>
                <span class="bg-teal-600 text-white text-xs font-semibold px-2 py-0.5 rounded-full">Admin</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-700">No active members.</p>
      <% end %>
    </div>

  </div>
</div>
