  <!-- ADDED BACKGROUND RADIENT LIKE Home PAGE -->
<section class="relative overflow-hidden -mt-7 bg-gradient-to-br from-slate-50 via-white to-teal-50">
<<div class="absolute top-0 left-0 w-92 h-92 bg-teal-300 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse pointer-events-none"></div>
<div class="absolute bottom-0 right-0 w-92 h-92 bg-cyan-200 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse delay-300 pointer-events-none"></div>


<div class="w-full px-6 md:px-12 py-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">

  <!-- LEFT CARD -->
  <div class="bg-white shadow-lg rounded-xl p-10 ml-10 mt-8 relative w-full md:w-100 md:col-span-1 self-start flex flex-col items-center md:items-start">

    <!-- Upgrade Button (top-right of left card) -->
    <a href="#"
       class="absolute top-5 right-6 bg-teal-600 text-white px-3 py-1.5 rounded-full text-sm font-medium hover:bg-teal-700 transition">
      Upgrade
    </a>

    <!-- Company Logo With Camera Icon -->
    <div class="relative w-32 h-32 mt-6 mx-auto">
      <% if @company.logo.attached? %>
        <%= image_tag url_for(@company.logo), class: "w-32 h-32 rounded-full object-cover border" %>
      <% else %>
        <div class="w-32 h-32 bg-gray-200 rounded-lg border flex items-center justify-center text-gray-500">
          No Logo
        </div>
      <% end %>

      <!-- Camera Icon for Upload -->
      <label class="absolute bottom-1 right-1.5 bg-gray-500 text-white p-2 rounded-full cursor-pointer hover:bg-gray-700">
        <i data-lucide="camera" class="w-4 h-4"></i>
        <%= form_with model: @company, url: company_path(@company), method: :patch, local: true, html: { multipart: true, class: "hidden" } do |f| %>
          <%= f.file_field :logo, onchange: "this.form.submit();" %>
        <% end %>
      </label>
    </div>

    <!-- Company Name & Admin -->
    <div class="mt-4 w-full text-center md:text-center">
      <h1 class="text-2xl font-bold"><%= @company.name %></h1>
      <% admin_user = @company.users.find_by(role: "admin") %>
      <p class="text-gray-600 mt-2 mb-1">Admin: <span class="font-medium"><%= admin_user&.username.titleize || "N/A" %></span></p>
    </div>

    <div class="w-full border-t my-4"></div>

    <!-- Subscription & Member Info -->
    <div class="space-y-4 w-full text-gray-700 text-lg">
      <p><strong class="mr-3">Subscription Status:</strong> <%= @company.subscription_status.titleize || "Free Plan" %></p>
      <p><strong class="mr-4">Member Limit:</strong> <%= @company.member_limit %></p>
      <% active_count = @company.users.count %>
      <p><strong class="mr-3">Active Members:</strong> <%= active_count %></p>
    </div>
  </div>

  <!-- RIGHT SIDE CONTENT -->
  <div class="md:col-span-2 space-y-8 self-start md:-ml-20">

    <!-- Create Button -->
    <div class="flex md:justify-end">
      <a href= <%= new_project_path %>
         class="flex items-center bg-teal-600 text-white px-4 py-2 rounded-lg shadow hover:bg-teal-700 transition">
        <span class="text-lg font-bold mr-2">+</span> Create Project
      </a>
    </div>

    <!-- Company Description -->
  <div>
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold mb-4">Company Description</h2>

    <!-- Pencil icon (shows the edit form) -->
      <% if @company.users.exists?(id: current_user.id, role: "admin") %>
        <button type="button" class="mr-220 mb-4 p-1 rounded-full hover:bg-gray-100" data-toggle-target="description">
          <i data-lucide="edit" class="w-5 h-5 text-gray-800"></i>
        </button>
      <% end %>
    </div>

    <!-- Display or edit area -->
    <div id="company-description-display" class="bg-gray-50 p-5 rounded-lg border text-gray-700 text-md">
      <%= simple_format(@company.description.presence || "No description available.") %>
    </div>

    <!-- Hidden edit form -->
    <div id="company-description-form" class="hidden">
      <%= form_with model: @company, url: company_path(@company), method: :patch, local: true, html: { multipart: true } do |f| %>
        <div class="mt-3">
          <%= f.label :description, "Edit description", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_area :description, rows: 4, class: "mt-1 ml-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>

        <div class="flex items-center justify-end mt-3 space-x-3">
          <button type="button" class="px-3 py-1 rounded border hover:bg-gray-200 transition" data-toggle-cancel="description">Cancel</button>
          <%= f.submit "Save", class: "bg-teal-600 text-white px-4 py-2 rounded-lg" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Services as Badges -->
  <div>
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold mb-5">Services</h2>

      <% if @company.users.exists?(id: current_user.id, role: "admin") %>
        <button type="button" class="mr-280 ml-1 mb-5 p-1 rounded-full hover:bg-gray-200" data-toggle-target="services">
          <i data-lucide="edit" class="w-5 h-5 text-gray-600"></i>
        </button>
      <% end %>
    </div>

    <!-- Display -->
    <% if @company.services.present? %>
      <div id="company-services-display" class="flex flex-wrap gap-2">
        <% @company.services.split(",").each do |service| %>
          <span class="bg-teal-100 text-teal-800 px-3 py-1 rounded-full text-md font-medium"><%= service.strip %></span>
        <% end %>
      </div>
    <% else %>
      <p id="company-services-display" class="text-gray-700">No services listed.</p>
    <% end %>
    
    <div id="company-services-form" class="hidden mt-4">
      <%= form_with model: @company, url: company_path(@company), method: :patch, local: true, html: { multipart: true } do |f| %>
        <div>
          <%= f.label :services, "Services (comma separated)", class: "block text-sm font-medium text-gray-700 mb-5" %>
          <%= f.text_field :services, class: "mt-1 py-4 block w-full text-lg pl-4 rounded-md border-gray-300 shadow-sm" %>
        </div>

        <div class="flex items-center justify-end mt-3 space-x-3">
          <button type="button" class="px-3 py-1 rounded border hover:bg-gray-200 transition" data-toggle-cancel="services">Cancel</button>
          <%= f.submit "Save", class: "bg-teal-600 text-white px-4 py-2 rounded-lg" %>
        </div>
      <% end %>
    </div>
  </div>


    <!-- Active Members -->
    <div>
      <h2 class="text-2xl font-semibold mb-5">Active Members</h2>
      <% if active_count > 0 %>
        <ul class="space-y-3">
          <% @company.users.each do |user| %>
            <li class="flex items-center space-x-3">
              <!-- Avatar -->
              <div class="w-10 h-10 rounded-full bg-gray-300 flex items-center justify-center text-gray-700 font-semibold">
                <%= user.username[0].upcase %>
              </div>

              <!-- Username -->
              <span class="font-medium text-lg text-gray-800"><%= user.username.titleize %></span>

              <!-- Admin Badge -->
              <% if user.role == "admin" %>
                <span class="bg-teal-600 text-white text-sm font-semibold px-2 py-0.5 rounded-full">Admin</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-700">No active members.</p>
      <% end %>
    </div>

  </div>
</div>
</div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    function showForm(key) {
      const display = document.getElementById(`company-${key}-display`);
      const form = document.getElementById(`company-${key}-form`);
      if (!display || !form) return;
      display.classList.add('hidden');
      form.classList.remove('hidden');

      // focus the first input/textarea inside form
      const field = form.querySelector('textarea, input');
      if (field) field.focus();
    }

    function hideForm(key) {
      const display = document.getElementById(`company-${key}-display`);
      const form = document.getElementById(`company-${key}-form`);
      if (!display || !form) return;
      form.classList.add('hidden');
      display.classList.remove('hidden');
    }

    // Wire up toggle buttons by data attribute `data-toggle-target`
    document.querySelectorAll('[data-toggle-target]').forEach(btn => {
      const key = btn.getAttribute('data-toggle-target'); // "description" or "services"
      btn.addEventListener('click', function(e) {
        showForm(key);
      });
    });

    // Wire up cancel buttons by data-toggle-cancel
    document.querySelectorAll('[data-toggle-cancel]').forEach(btn => {
      const key = btn.getAttribute('data-toggle-cancel');
      btn.addEventListener('click', function(e) {
        hideForm(key);
      });
    });
  });
</script>

</section>