<turbo-frame id="company_services">
  <!-- Heading with section icon and edit button -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <i data-lucide="briefcase" class="w-6 h-6 text-teal-700"></i> <!-- Section icon -->
      <h2 class="text-2xl font-semibold">Services</h2>
    </div>

    <% if can_edit_company?(current_user) %>
      <%# Show edit button only when not editing %>
      <% unless @edit_section == "services" %>
        <%= link_to company_path(company, edit: "services"), class: "inline-flex items-center p-1 rounded-full hover:bg-gray-100" do %>
          <i data-lucide="edit" class="w-5 h-5 text-gray-600"></i>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Content: either display or edit form -->
  <% if can_edit_company?(current_user) && @edit_section == "services" %>
    <%= form_with model: company, url: company_path(company), method: :patch, local: false do |f| %>
      <%= f.label :services, "Services (comma separated)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :services, class: "mt-1 py-2 block w-full text-lg pl-4 rounded-md border-gray-300 shadow-sm mb-4" %>

      <div class="flex items-center justify-end mt-3 space-x-3">
        <%= link_to "Cancel", company_path(company), class: "px-3 py-1 rounded border hover:bg-gray-200" %>
        <%= f.submit "Save", class: "bg-teal-600 text-white px-4 py-2 rounded-lg" %>
      </div>
    <% end %>
  <% else %>
    <% if company.services.present? %>
      <div class="flex flex-wrap gap-2 mb-6">
        <% company.services.split(",").each do |service| %>
          <span class="bg-teal-100 text-teal-800 px-3 py-1 rounded-full text-md font-medium"><%= service.strip %></span>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-700 mb-6">No services listed.</p>
    <% end %>
  <% end %>
</turbo-frame>
