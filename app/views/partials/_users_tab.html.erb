<div class="tab-content-wrapper py-10">
  <h1 class="text-center text-4xl font-bold mb-10">
            <span class="inline-flex text-teal-800 items-center justify-center">
              <i class="bi bi-people-fill text-3xl"></i>
              Manage and monitor all platform users
            </span>
  </h1>

  <!-- Stats Cards -->
  <div class="flex flex-wrap gap-4 mb-6 justify-start px-8 ml-12 mb-12">

    <!-- Total Users - Increased Width and Height -->
    <div class="stat-card teal-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon"
           style="background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%); width: 80px; height: 80px;">
        <i class="bi bi-people-fill" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">Total Users</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @users.count %></span>
      </div>
    </div>

    <!-- Admins - Increased Width and Height -->
    <div class="stat-card blue-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon"
           style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); width: 80px; height: 80px;">
        <i class="bi bi-person-badge" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">Admins</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @users.where(role: 'admin').count %></span>
      </div>
    </div>

    <!-- Managers - Increased Width and Height -->
    <div class="stat-card purple-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon"
           style="background: linear-gradient(135deg, #a855f7 0%, #9333ea 100%); width: 80px; height: 80px;">
        <i class="bi bi-briefcase-fill" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">Managers</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @users.where(role: 'manager').count %></span>
      </div>
    </div>

    <!-- Employees - Increased Width and Height -->
    <div class="stat-card orange-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon"
           style="background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); width: 80px; height: 80px;">
        <i class="bi bi-person-workspace" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">Employees</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @users.where(role: 'employee').count %></span>
      </div>
    </div>

    <!-- Clients - Increased Width and Height -->
    <div class="stat-card purple-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon"
           style="background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); width: 80px; height: 80px;">
        <i class="bi bi-person-check" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">Clients</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @users.where(role: 'client').count %></span>
      </div>
    </div>
    
</div>

  <!-- Users Table Card -->
  <div class="modern-card">
   <div class="card-header-custom">
    <div class="header-row">
      <h3 class="card-title-custom">
        <i class="bi bi-list-ul"></i> All Users
      </h3>
      <div class="search-box">
        <i class="bi bi-search"></i>
        <input
          type="text"
          id="userSearch"
          placeholder="Search users..."
          class="form-control"
        >
      </div>
    </div>
  </div>

    <div class="card-body-custom">
      <div class="table-responsive flex justify-between ml-10 mt-5">
        <table class="table modern-table w-auto">
          <thead>
            <tr>
              <th><i class="bi bi-person"></i> Username</th>
              <th><i class="bi bi-envelope"></i> Email</th>
              <th><i class="bi bi-shield-check"></i> Role</th>
              <th><i class="bi bi-building"></i> Related Company</th>
              <th><i class="bi bi-calendar-plus"></i> Created At</th>
              <th><i class="bi bi-gear"></i> Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr class="table-row-hover">
                <td>
                  <div class="user-info">
                    <div class="user-avatar">
                      <%= user.username.first.upcase %>
                    </div>
                    <strong><%= user.username %></strong>
                  </div>
                </td>
                <td class="text-muted"><%= user.email %></td>
                <td>
                  <span class="badge-custom badge-<%= user.role %>">
                     <%= user.role %>
                  </span>
                </td>
                <td>
                  <% if user.company %>
                    <span class="company-tag">
                      <i class="bi bi-building-fill"></i> <%= user.company.name %>
                    </span>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>
                <td class="text-muted">
                  <i class="bi bi-calendar3"></i> <%= user.created_at.strftime('%B %d, %Y') %>
                </td>
                <td>
                  <%= button_to super_admin_destroy_user_path(user), 
                      method: :delete, 
                      data: { confirm: 'Are you sure you want to delete this user?' },
                      class: 'btn-delete' do %>
                    <i class="bi bi-trash"></i> Delete
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
