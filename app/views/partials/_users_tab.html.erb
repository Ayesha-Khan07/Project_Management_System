<div class="tab-content-wrapper">
  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="stat-card teal-gradient">
        <div class="stat-icon">
          <i class="bi bi-people-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @users.count %></h3>
          <p>Total Users</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="stat-card blue-gradient">
        <div class="stat-icon">
          <i class="bi bi-person-badge"></i>
        </div>
        <div class="stat-info">
          <h3><%= @users.where(role: 'admin').count %></h3>
          <p>Admins</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="stat-card purple-gradient">
        <div class="stat-icon">
          <i class="bi bi-briefcase-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @users.where(role: 'manager').count %></h3>
          <p>Managers</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="stat-card orange-gradient">
        <div class="stat-icon">
          <i class="bi bi-person-workspace"></i>
        </div>
        <div class="stat-info">
          <h3><%= @users.where(role: 'employee').count %></h3>
          <p>Employees</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Table Card -->
  <div class="modern-card">
    <div class="card-header-custom">
      <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <h3 class="card-title-custom">
            <i class="bi bi-list-ul"></i> All Users
          </h3>
          <p class="card-subtitle-custom">Manage and monitor all platform users</p>
        </div>
        <div class="search-box">
          <i class="bi bi-search"></i>
          <input type="text" id="userSearch" placeholder="Search users..." class="form-control">
        </div>
      </div>
    </div>
    <div class="card-body-custom">
      <div class="table-responsive">
        <table class="table modern-table">
          <thead>
            <tr>
              <th><i class="bi bi-person"></i> Username</th>
              <th><i class="bi bi-envelope"></i> Email</th>
              <th><i class="bi bi-shield-check"></i> Role</th>
              <th><i class="bi bi-building"></i> Related Company</th>
              <th><i class="bi bi-calendar-plus"></i> Created At</th>
              <th><i class="bi bi-gear"></i> Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr class="table-row-hover">
                <td>
                  <div class="user-info">
                    <div class="user-avatar">
                      <%= user.username.first.upcase %>
                    </div>
                    <strong><%= user.username %></strong>
                  </div>
                </td>
                <td class="text-muted"><%= user.email %></td>
                <td>
                  <span class="badge-custom badge-<%= user.role %>">
                    <i class="bi bi-dot"></i> <%= user.role %>
                  </span>
                </td>
                <td>
                  <% if user.company %>
                    <span class="company-tag">
                      <i class="bi bi-building-fill"></i> <%= user.company.name %>
                    </span>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>
                <td class="text-muted">
                  <i class="bi bi-calendar3"></i> <%= user.created_at.strftime('%B %d, %Y') %>
                </td>
                <td>
                  <%= button_to super_admin_destroy_user_path(user), 
                      method: :delete, 
                      data: { confirm: 'Are you sure you want to delete this user?' },
                      class: 'btn-delete' do %>
                    <i class="bi bi-trash"></i> Delete
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>