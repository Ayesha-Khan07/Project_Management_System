<div class="card mb-4">
  <div class="card-header">
    <h3>All Companies</h3>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Name</th>
            <th>Subscription Status</th>
            <th>Member Limit</th>
            <th>No. of Projects</th>
            <th>Created At</th>
          </tr>
        </thead>
        <tbody>
          <% @companies.each do |company| %>
            <tr>
              <td><%= company.name %></td>
              <td>
                <span class="badge <%= company.subscription_status == 'paid' ? 'bg-success' : 'bg-secondary' %>">
                  <%= company.subscription_status.upcase %>
                </span>
              </td>
              <td><%= company.member_limit %></td>
              <td><%= company.projects.count %></td>
              <td><%= company.created_at.strftime('%B %d, %Y') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Subscription Status Chart -->
<div class="card">
  <div class="card-header">
    <h3>Subscription Status Distribution</h3>
  </div>
  <div class="card-body">
    <%= pie_chart @subscription_chart_data, 
        colors: ['#6c757d', '#28a745'],
        library: { 
          plugins: { 
            legend: { position: 'bottom' } 
          } 
        } %>
  </div>
</div>