<div class="tab-content-wrapper">
  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <div class="stat-card teal-gradient">
        <div class="stat-icon">
          <i class="bi bi-building-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @companies.count %></h3>
          <p>Total Companies</p>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="stat-card green-gradient">
        <div class="stat-icon">
          <i class="bi bi-check-circle-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @companies.where(subscription_status: 'paid').count %></h3>
          <p>Paid Subscriptions</p>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="stat-card gray-gradient">
        <div class="stat-icon">
          <i class="bi bi-x-circle-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @companies.where(subscription_status: 'free').count %></h3>
          <p>Free Subscriptions</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Companies Table Card -->
  <div class="modern-card mb-4">
    <div class="card-header-custom">
      <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <h3 class="card-title-custom">
            <i class="bi bi-building"></i> All Companies
          </h3>
          <p class="card-subtitle-custom">Overview of all registered companies</p>
        </div>
        <div class="search-box">
          <i class="bi bi-search"></i>
          <input type="text" id="companySearch" placeholder="Search companies..." class="form-control">
        </div>
      </div>
    </div>
    <div class="card-body-custom">
      <div class="table-responsive">
        <table class="table modern-table">
          <thead>
            <tr>
              <th><i class="bi bi-building"></i> Name</th>
              <th><i class="bi bi-credit-card"></i> Subscription Status</th>
              <th><i class="bi bi-people"></i> Member Limit</th>
              <th><i class="bi bi-folder"></i> No. of Projects</th>
              <th><i class="bi bi-calendar-plus"></i> Created At</th>
            </tr>
          </thead>
          <tbody>
            <% @companies.each do |company| %>
              <tr class="table-row-hover">
                <td>
                  <div class="company-info">
                    <div class="company-avatar">
                      <%= company.name.first.upcase %>
                    </div>
                    <strong><%= company.name %></strong>
                  </div>
                </td>
                <td>
                  <span class="subscription-badge subscription-<%= company.subscription_status %>">
                    <i class="bi bi-<%= company.subscription_status == 'paid' ? 'check-circle-fill' : 'circle' %>"></i>
                    <%= company.subscription_status.upcase %>
                  </span>
                </td>
                <td>
                  <span class="member-limit-badge">
                    <i class="bi bi-people-fill"></i> <%= company.member_limit %>
                  </span>
                </td>
                <td>
                  <span class="project-count-badge">
                    <i class="bi bi-folder-fill"></i> <%= company.projects.count %>
                  </span>
                </td>
                <td class="text-muted">
                  <i class="bi bi-calendar3"></i> <%= company.created_at.strftime('%B %d, %Y') %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Subscription Status Chart -->
  <div class="modern-card chart-card">
    <div class="card-header-custom">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h3 class="card-title-custom">
            <i class="bi bi-pie-chart-fill"></i> Subscription Status Distribution
          </h3>
          <p class="card-subtitle-custom">Visual breakdown of subscription types</p>
        </div>
      </div>
    </div>
    <div class="card-body-custom chart-body">
      <div class="chart-wrapper">
        <%= pie_chart @subscription_chart_data, 
            colors: ['#9ca3af', '#14b8a6'],
            library: { 
              plugins: { 
                legend: { 
                  position: 'bottom',
                  labels: {
                    padding: 20,
                    font: {
                      size: 14,
                      family: "'Inter', sans-serif"
                    },
                    usePointStyle: true
                  }
                }
              },
              layout: {
                padding: 20
              }
            },
            height: '350px' %>
      </div>
    </div>
  </div>
</div>