<!-- Navbar -->
<header class="flex items-center justify-between py-7 px-10 bg-white shadow-sm sticky top-0 z-50">

 <% if current_page?(root_path) %>
  <h1 class="text-2xl font-bold text-teal-700">ClientProject<span class="text-gray-900">Hub</span></h1>  
  <nav class="hidden md:flex space-x-6 text-gray-700 mt-5 font-medium">
    <a href="#features" class="relative hover:text-teal-600 transition before:absolute before:-bottom-2 before:left-0 before:w-0 before:h-[2px] before:bg-teal-600 before:transition-all before:duration-300 hover:before:w-full">Features</a>
    <a href="#how-it-works" class="relative hover:text-teal-600 transition before:absolute before:-bottom-2 before:left-0 before:w-0 before:h-[2px] before:bg-teal-600 before:transition-all before:duration-300 hover:before:w-full">How It Works</a>
    <a href="#pricing" class="relative hover:text-teal-600 transition before:absolute before:-bottom-2 before:left-0 before:w-0 before:h-[2px] before:bg-teal-600 before:transition-all before:duration-300 hover:before:w-full">Pricing</a>
    <a href="#contact" class="relative hover:text-teal-600 transition before:absolute before:-bottom-2 before:left-0 before:w-0 before:h-[2px] before:bg-teal-600 before:transition-all before:duration-300 hover:before:w-full">Contact</a>
  </nav>
  <div class="flex space-x-4">
    <%= link_to "Login", login_ceo_path, class: "relative text-gray-700 font-medium hover:text-teal-600 mt-2 before:absolute before:-bottom-1 before:left-0 before:w-0 before:h-[2px] before:bg-teal-600 before:transition-all before:duration-300 hover:before:w-full" %>
    <%= link_to "Get Started", new_ceo_signup_path, class: "bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold shadow hover:bg-teal-700 transition" %>
  </div>

 <% elsif current_page?(login_ceo_path) %>
  <h1 class="text-2xl font-bold text-teal-700">ClientProject<span class="text-gray-900">Hub</span></h1>

 <% elsif controller_name == "companies" && action_name == "show" %>
  <div class="flex items-center space-x-6">
    <!-- Company logo -->
    <% if @company.logo.attached? %>
      <%= image_tag url_for(@company.logo), alt: "Logo", class: "w-10 h-10 rounded-full" %>
    <% else %>
      <%= image_tag "default_logo.png", alt: "Logo", class: "w-10 h-10 rounded-full" %>
    <% end %>

    <span class="text-teal-600 font-bold text-xl"><%= @company.name %></span>
    <%= link_to "Projects", company_projects_path(@company), class: "text-gray-700 hover:text-teal-600 font-medium" %>
    <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold shadow hover:bg-teal-700 transition" %>
  </div>

 <% else %>
  <h1 class="text-2xl font-bold text-teal-700">ClientProject<span class="text-gray-900">Hub</span></h1>  
 <% end %>

  <div class="flex space-x-4">
     <% if user_signed_in? %>
      <% if current_user.company.present? %>
          <%= link_to "Profile", company_path(current_user.company), class: "relative text-gray-700 font-medium hover:text-teal-600 mt-2 before:absolute before:-bottom-1 before:left-0 before:w-0 before:h-[2px] before:bg-teal-600 before:transition-all before:duration-300 hover:before:w-full" %>
      <% end %>  
      <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold shadow hover:bg-teal-700 transition" %>
     <% end%>
      
  </div>
</header>