<header class="relative py-7 px-10 bg-white shadow-sm sticky top-0 z-50">
  <div class="flex items-center justify-between w-full">

    <!-- LEFT: Logo / Title -->
    <div class="flex items-center space-x-4">
      <% company =
           @company ||
           @project&.company ||
           @task&.project&.company ||
           current_user&.company
      %>

      <% if company.present? && !current_user&.super_admin? %>
        <%= link_to root_path, class: "flex items-center space-x-4" do %>

          <% if company.logo.attached? %>
            <%= image_tag company.logo, class: "w-10 h-10 rounded-full object-cover" %>
          <% end %>
          <span class="text-teal-600 font-bold text-xl"><%= company.name %></span>

        <%end%>

      <% else %>
          <%= link_to root_path do %>
            <h1 class="text-2xl font-bold text-teal-700">
              ClientProject<span class="text-gray-900">Hub</span>
            </h1>
          <% end %>
      <% end %>

    </div>

    <!-- CENTER: Navigation -->
    <nav class="flex-1 flex justify-center space-x-6">

      <% if current_page?(root_path) %>
        <%= link_to "Features", "#features", class: nav_link %>
        <%= link_to "How It Works", "#how-it-works", class: nav_link %>
        <%= link_to "Pricing", "#pricing", class: nav_link %>
        <%= link_to "Contact", "#contact", class: nav_link %>

        <% if user_signed_in? && current_user.super_admin? %>
          <%= link_to "Dashboard", super_admin_dashboard_path, class: nav_link %>
        <% elsif user_signed_in? && current_user.company.present? %>
          <%= link_to "Profile", company_path(current_user.company), class: nav_link %>
        <% end %>
      <% end %>

      <% if controller_name == "companies" && action_name == "show" %>
        <%= link_to "Home", root_path, class: nav_link %>
        <%= link_to "Projects", company_projects_path(@company), class: nav_link %>
      <% end %>

      <% if controller_name == "projects" && action_name == "show" %>
        <%= link_to "Projects", company_projects_path(@project.company), class: nav_link %>
        <%= link_to "Profile", company_path(@project.company), class: nav_link %>
      <% end %>

      <% if controller_name == "projects" && (action_name == "index" || action_name == "new") %>
        <%= link_to "Home", root_path, class: nav_link %>
        <%= link_to "Profile", company_path(current_user.company), class: nav_link %>
      <% end %>

      <% if controller_name == "tasks" && (action_name == "show" || action_name = "new")  %>
        <%= link_to "Project", project_path(@task.project), class: nav_link %>
        <%= link_to "Profile", company_path(@task.project.company), class: nav_link %>
      <% end %>

      <% if current_user&.super_admin? && !current_page?(root_path) %>
        <%= link_to "Home", root_path, class: nav_link %>
      <% end %>

    </nav>

    <!-- RIGHT: Auth Buttons -->
    <div class="flex items-center space-x-4">
      <% if !user_signed_in? %>
        <%= link_to "Login", new_user_session_path, class: nav_link %>
        <%= link_to "Get Started", new_user_registration_path,
              class: "bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 transition" %>
      <% else %>
        <%= button_to "Logout", destroy_user_session_path,
              method: :delete,
              class: "bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 transition" %>
      <% end %>
    </div>

  </div>
</header>
