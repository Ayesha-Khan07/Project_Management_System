<div class="tab-content-wrapper py-10">
  <h1 class="text-center text-4xl font-bold mb-10">
    <span class="inline-flex text-teal-800 items-center justify-center">
      <i class="bi bi-folder-fill text-3xl"></i>
      Manage and monitor all projects
    </span>
  </h1>

  <!-- Stats Cards -->
  <div class="flex flex-wrap gap-4 mb-6 justify-center px-8 ml-12 mb-12">

    <!-- Total Projects -->
    <div class="stat-card teal-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon" style="background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%); width: 80px; height: 80px;">
        <i class="bi bi-folder-fill" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">Total Projects</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @projects.count %></span>
      </div>
    </div>

    <!-- Pending Projects -->
    <div class="stat-card yellow-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon" style="background: linear-gradient(135deg, #facc15 0%, #eab308 100%); width: 80px; height: 80px;">
        <i class="bi bi-hourglass-split" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">Pending</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @projects.where(project_status: 'pending').count %></span>
      </div>
    </div>

    <!-- In Progress Projects -->
    <div class="stat-card blue-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); width: 80px; height: 80px;">
        <i class="bi bi-gear-fill" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">In Progress</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @projects.where(project_status: 'working').count %></span>
      </div>
    </div>

    <!-- Completed Projects -->
    <div class="stat-card green-gradient rounded-xl p-6 ml-10 shadow-md" style="min-width: 280px; min-height: 160px;">
      <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); width: 80px; height: 80px;">
        <i class="bi bi-check-circle-fill" style="font-size: 2.5rem;"></i>
      </div>
      <div class="flex flex-col mt-3">
        <span class="text-gray-500 font-medium text-2xl mb-3">Completed</span>
        <span class="text-gray-900 font-bold text-3xl ml-2"><%= @projects.where(project_status: 'completed').count %></span>
      </div>
    </div>

  </div>

  <!-- Projects Table Card -->
  <div class="modern-card">
    <div class="card-header-custom">
      <div class="header-row">
        <h3 class="card-title-custom">
          <i class="bi bi-folder2-open"></i> All Projects
        </h3>
        <div class="search-box">
          <i class="bi bi-search"></i>
          <input type="text" id="projectSearch" placeholder="Search projects..." class="form-control">
        </div>
      </div>
    </div>

    <div class="card-body-custom">
      <div class="table-responsive flex justify-between ml-10 mt-5">
        <table class="table modern-table w-auto">
          <thead>
            <tr>
              <th><i class="bi bi-file-text"></i> Title</th>
              <th><i class="bi bi-activity"></i> Status</th>
              <th><i class="bi bi-calendar-check"></i> Deadline</th>
              <th><i class="bi bi-building"></i> Company</th>
              <th><i class="bi bi-person-fill"></i> Active Members</th>
            </tr>
          </thead>
          <tbody>
            <% @projects.each do |project| %>
              <tr class="table-row-hover">
                <td>
                  <div class="project-info">
                    <div class="project-icon">
                      <i class="bi bi-folder-fill"></i>
                    </div>
                    <div>
                      <strong><%= project.title %></strong>
                    </div>
                  </div>
                </td>
                <td>
                  <% 
                    status_class = case project.project_status
                    when 'pending' then 'warning'
                    when 'working' then 'primary'
                    when 'completed' then 'success'
                    else 'secondary'
                    end
                  %>
                  <span class="status-badge status-<%= status_class %>">
                    <span class="status-dot"></span>
                    <%= project.project_status&.upcase || 'N/A' %>
                  </span>
                </td>
                <td>
                  <% if project.project_deadline %>
                    <div class="deadline-badge">
                      <i class="bi bi-calendar-event"></i>
                      <%= project.project_deadline.strftime('%B %d, %Y') %>
                    </div>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>
                <td>
                  <div class="company-tag-inline">
                    <div class="company-avatar-small">
                      <%= project.company.name.first.upcase %>
                    </div>
                    <%= project.company.name %>
                  </div>
                </td>
                <td>
                  <% if project.users.any? %>
                    <div class="client-info">
                      <div class="client-avatar">
                        <%= project.users.count %>
                      </div>
                    </div>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Project Status Chart -->
  <div class="modern-card chart-card mt-8">
    <div class="card-header-custom">
      <div class="header-row">
        <h3 class="card-title-custom">
          <i class="bi bi-bar-chart-fill"></i> Project Status Distribution
        </h3>
      </div>
    </div>
    <div class="card-body-custom chart-body">
      <div class="chart-wrapper">
        <%= column_chart @project_status_chart_data, 
            colors: ['#fbbf24', '#3b82f6', '#10b981'],
            library: { 
              plugins: { legend: { display: false } },
              scales: {
                y: { beginAtZero: true, grid: { color: '#f3f4f6' }, ticks: { font: { family: "'Inter', sans-serif" } } },
                x: { grid: { display: false }, ticks: { font: { family: "'Inter', sans-serif", size: 12 } } }
              }
            },
            height: '350px' %>
      </div>
    </div>
  </div>
</div>
