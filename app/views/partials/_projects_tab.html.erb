<div class="tab-content-wrapper">
  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="stat-card teal-gradient">
        <div class="stat-icon">
          <i class="bi bi-folder-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @projects.count %></h3>
          <p>Total Projects</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="stat-card yellow-gradient">
        <div class="stat-icon">
          <i class="bi bi-hourglass-split"></i>
        </div>
        <div class="stat-info">
          <h3><%= @projects.where(project_status: 'pending').count %></h3>
          <p>Pending</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="stat-card blue-gradient">
        <div class="stat-icon">
          <i class="bi bi-gear-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @projects.where(project_status: 'working').count %></h3>
          <p>In Progress</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="stat-card green-gradient">
        <div class="stat-icon">
          <i class="bi bi-check-circle-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @projects.where(project_status: 'completed').count %></h3>
          <p>Completed</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Projects Table Card -->
  <div class="modern-card mb-4">
    <div class="card-header-custom">
      <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <h3 class="card-title-custom">
            <i class="bi bi-folder2-open"></i> All Projects
          </h3>
          <p class="card-subtitle-custom">Comprehensive overview of all projects across companies</p>
        </div>
        <div class="search-box">
          <i class="bi bi-search"></i>
          <input type="text" id="projectSearch" placeholder="Search projects..." class="form-control">
        </div>
      </div>
    </div>
    <div class="card-body-custom">
      <div class="table-responsive">
        <table class="table modern-table">
          <thead>
            <tr>
              <th><i class="bi bi-file-text"></i> Title</th>
              <th><i class="bi bi-activity"></i> Status</th>
              <th><i class="bi bi-calendar-check"></i> Deadline</th>
              <th><i class="bi bi-building"></i> Company</th>
              <th><i class="bi bi-person"></i> Client</th>
            </tr>
          </thead>
          <tbody>
            <% @projects.each do |project| %>
              <tr class="table-row-hover">
                <td>
                  <div class="project-info">
                    <div class="project-icon">
                      <i class="bi bi-folder-fill"></i>
                    </div>
                    <div>
                      <strong><%= project.title %></strong>
                    </div>
                  </div>
                </td>
                <td>
                  <% 
                    status_class = case project.project_status
                    when 'pending' then 'warning'
                    when 'working' then 'primary'
                    when 'completed' then 'success'
                    else 'secondary'
                    end
                  %>
                  <span class="status-badge status-<%= status_class %>">
                    <span class="status-dot"></span>
                    <%= project.project_status&.upcase || 'N/A' %>
                  </span>
                </td>
                <td>
                  <% if project.project_deadline %>
                    <div class="deadline-badge">
                      <i class="bi bi-calendar-event"></i>
                      <%= project.project_deadline.strftime('%B %d, %Y') %>
                    </div>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>
                <td>
                  <div class="company-tag-inline">
                    <div class="company-avatar-small">
                      <%= project.company.name.first.upcase %>
                    </div>
                    <%= project.company.name %>
                  </div>
                </td>
                <td>
                  <% if project.client %>
                    <div class="client-info">
                      <div class="client-avatar">
                        <%= project.client.username.first.upcase %>
                      </div>
                      <%= project.client.username %>
                    </div>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Project Status Chart -->
  <div class="modern-card chart-card">
    <div class="card-header-custom">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h3 class="card-title-custom">
            <i class="bi bi-bar-chart-fill"></i> Project Status Distribution
          </h3>
          <p class="card-subtitle-custom">Visual breakdown of project statuses</p>
        </div>
      </div>
    </div>
    <div class="card-body-custom chart-body">
      <div class="chart-wrapper">
        <%= column_chart @project_status_chart_data, 
            colors: ['#fbbf24', '#3b82f6', '#10b981'],
            library: { 
              plugins: { 
                legend: { 
                  display: false
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  grid: {
                    color: '#f3f4f6'
                  },
                  ticks: {
                    font: {
                      family: "'Inter', sans-serif"
                    }
                  }
                },
                x: {
                  grid: {
                    display: false
                  },
                  ticks: {
                    font: {
                      family: "'Inter', sans-serif",
                      size: 12
                    }
                  }
                }
              }
            },
            height: '350px' %>
      </div>
    </div>
  </div>
</div>