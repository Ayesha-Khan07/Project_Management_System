<div class="card mb-4">
  <div class="card-header">
    <h3>All Projects</h3>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Deadline</th>
            <th>Company</th>
            <th>Client</th>
          </tr>
        </thead>
        <tbody>
          <% @projects.each do |project| %>
            <tr>
              <td><%= project.title %></td>
              <td>
                <span class="badge 
                  <%= case project.project_status
                      when 'pending' then 'bg-warning'
                      when 'working' then 'bg-primary'
                      when 'completed' then 'bg-success'
                      end %>">
                   <%= project.project_status&.upcase || 'N/A' %>
                </span>
              </td>
              <td><%= project.project_deadline&.strftime('%B %d, %Y') || 'N/A' %></td>
              <td><%= project.company.name %></td>
              <td><%= project.client&.username || 'N/A' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Project Status Chart -->
<div class="card">
  <div class="card-header">
    <h3>Project Status Distribution</h3>
  </div>
  <div class="card-body">
    <%= column_chart @project_status_chart_data, 
        colors: ['#ffc107', '#007bff', '#28a745'] %>
  </div>
</div>