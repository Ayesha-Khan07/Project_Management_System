<%= form_with(model: [ @project, @task ]) do |f| %>
  <div class="mb-4">
    <%= f.label :title, "Title", class: "block font-semibold mb-2" %>
    <%= f.text_field :title, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :description, "Description", class: "block font-semibold mb-2" %>
    <%= f.text_area :description, rows: 4, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :task_type, "Type", class: "block font-semibold mb-2" %>
    <%= f.select :task_type, Task.task_types.keys.map { |t| [t.humanize, t] }, {}, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :task_status, "Status", class: "block font-semibold mb-2" %>
    <%= f.select :task_status, Task.task_statuses.keys.map { |s| [s.humanize, s] }, {}, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :progress, "Progress", class: "block font-semibold mb-2" %>
    <%= f.select :progress, Task.progresses.keys.map { |p| [p, p] }, {}, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :estimated_deadline, "Estimated Deadline", class: "block font-semibold mb-2" %>
    <%= f.date_field :estimated_deadline, class: "border rounded px-2 py-1 w-full", min: Date.today %>
  </div>

  <div class="mb-4">
    <%= f.label :assigned_user_id, "Assign to Employee", class: "block font-semibold mb-2" %>
    <%= f.select :assigned_user_id, @employees.map { |u| [u.username, u.id] }, {}, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <div class="mt-8">
    <%= f.submit class: "bg-teal-500 text-white px-4 py-2 rounded hover:bg-teal-600 transition" %>
  </div>
<% end %>
