<div class="tab-content-wrapper">
  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="stat-card teal-gradient">
        <div class="stat-icon">
          <i class="bi bi-check2-square"></i>
        </div>
        <div class="stat-info">
          <h3><%= @tasks.count %></h3>
          <p>Total Tasks</p>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="stat-card yellow-gradient">
        <div class="stat-icon">
          <i class="bi bi-clock-history"></i>
        </div>
        <div class="stat-info">
          <h3><%= @tasks.where(task_status: 'not_started').count %></h3>
          <p>Not Started</p>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="stat-card blue-gradient">
        <div class="stat-icon">
          <i class="bi bi-arrow-repeat"></i>
        </div>
        <div class="stat-info">
          <h3><%= @tasks.where(task_status: 'in_progress').count %></h3>
          <p>In Progress</p>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="stat-card green-gradient">
        <div class="stat-icon">
          <i class="bi bi-check-circle-fill"></i>
        </div>
        <div class="stat-info">
          <h3><%= @tasks.where(task_status: 'completed').count %></h3>
          <p>Completed</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Tasks Table Card -->
  <div class="modern-card mb-4">
    <div class="card-header-custom">
      <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <h3 class="card-title-custom">
            <i class="bi bi-list-task"></i> All Tasks
          </h3>
          <p class="card-subtitle-custom">Complete overview of all tasks across projects</p>
        </div>
        <div class="search-box">
          <i class="bi bi-search"></i>
          <input type="text" id="taskSearch" placeholder="Search tasks..." class="form-control">
        </div>
      </div>
    </div>
    <div class="card-body-custom">
      <div class="table-responsive">
        <table class="table modern-table">
          <thead>
            <tr>
              <th><i class="bi bi-file-text"></i> Title</th>
              <th><i class="bi bi-tag"></i> Type</th>
              <th><i class="bi bi-activity"></i> Status</th>
              <th><i class="bi bi-graph-up"></i> Progress</th>
              <th><i class="bi bi-calendar-check"></i> Deadline</th>
              <th><i class="bi bi-folder"></i> Project</th>
              <th><i class="bi bi-person-check"></i> Assignee</th>
              <th><i class="bi bi-building"></i> Company</th>
              <th><i class="bi bi-calendar-plus"></i> Created</th>
            </tr>
          </thead>
          <tbody>
            <% @tasks.each do |task| %>
              <tr class="table-row-hover">
                <td>
                  <div class="task-info">
                    <div class="task-icon">
                      <i class="bi bi-check-square"></i>
                    </div>
                    <strong><%= task.title %></strong>
                  </div>
                </td>
                <td>
                  <span class="task-type-badge">
                    <i class="bi bi-tag-fill"></i>
                    <%= task.task_type %>
                  </span>
                </td>
                <td>
                  <span class="task-status-badge status-<%= task.task_status.gsub('_', '-') %>">
                    <span class="status-indicator"></span>
                    <%= task.task_status.gsub('_', ' ').titleize %>
                  </span>
                </td>
                <td>
                  <div class="progress-wrapper">
                    <% progress_value = task.progress.gsub('%', '').to_i %>
                    <div class="custom-progress">
                      <div class="progress-bar-custom" 
                           style="width: <%= progress_value %>%"
                           data-progress="<%= progress_value %>">
                      </div>
                    </div>
                    <span class="progress-text"><%= task.progress %></span>
                  </div>
                </td>
                <td>
                  <% if task.estimated_deadline %>
                    <div class="deadline-tag">
                      <i class="bi bi-calendar-event"></i>
                      <%= task.estimated_deadline.strftime('%b %d, %Y') %>
                    </div>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>
                <td>
                  <div class="project-tag">
                    <i class="bi bi-folder-fill"></i>
                    <%= task.project.title %>
                  </div>
                </td>
                <td>
                  <div class="assignee-info">
                    <div class="assignee-avatar">
                      <%= task.assigned_user.username.first.upcase %>
                    </div>
                    <%= task.assigned_user.username %>
                  </div>
                </td>
                <td>
                  <div class="company-mini-tag">
                    <%= task.project.company.name %>
                  </div>
                </td>
                <td class="text-muted">
                  <small><%= task.created_at.strftime('%b %d, %Y') %></small>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Task Charts -->
  <div class="row">
    <div class="col-lg-4 mb-4">
      <div class="modern-card chart-card">
        <div class="card-header-custom">
          <h4 class="chart-title">
            <i class="bi bi-pie-chart-fill"></i> Task Types
          </h4>
          <p class="chart-subtitle">Distribution by type</p>
        </div>
        <div class="card-body-custom chart-body">
          <div class="chart-wrapper-small">
            <%= pie_chart @task_type_chart_data,
                colors: ['#14b8a6', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6'],
                library: { 
                  plugins: { 
                    legend: { 
                      position: 'bottom',
                      labels: {
                        padding: 15,
                        font: {
                          size: 11,
                          family: "'Inter', sans-serif"
                        },
                        usePointStyle: true
                      }
                    }
                  }
                },
                height: '280px' %>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4 mb-4">
      <div class="modern-card chart-card">
        <div class="card-header-custom">
          <h4 class="chart-title">
            <i class="bi bi-bar-chart-fill"></i> Task Status
          </h4>
          <p class="chart-subtitle">Current status breakdown</p>
        </div>
        <div class="card-body-custom chart-body">
          <div class="chart-wrapper-small">
            <%= column_chart @task_status_chart_data,
                colors: ['#fbbf24', '#3b82f6', '#10b981'],
                library: { 
                  plugins: { 
                    legend: { 
                      display: false
                    }
                  },
                  scales: {
                    y: {
                      beginAtZero: true,
                      grid: {
                        color: '#f3f4f6'
                      },
                      ticks: {
                        font: {
                          family: "'Inter', sans-serif",
                          size: 10
                        }
                      }
                    },
                    x: {
                      grid: {
                        display: false
                      },
                      ticks: {
                        font: {
                          family: "'Inter', sans-serif",
                          size: 10
                        }
                      }
                    }
                  }
                },
                height: '280px' %>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4 mb-4">
      <div class="modern-card chart-card">
        <div class="card-header-custom">
          <h4 class="chart-title">
            <i class="bi bi-graph-up-arrow"></i> Task Progress
          </h4>
          <p class="chart-subtitle">Completion metrics</p>
        </div>
        <div class="card-body-custom chart-body">
          <div class="chart-wrapper-small">
            <%= bar_chart @task_progress_chart_data,
                colors: ['#14b8a6'],
                library: { 
                  plugins: { 
                    legend: { 
                      display: false
                    }
                  },
                  scales: {
                    y: {
                      beginAtZero: true,
                      grid: {
                        color: '#f3f4f6'
                      },
                      ticks: {
                        font: {
                          family: "'Inter', sans-serif",
                          size: 10
                        }
                      }
                    },
                    x: {
                      grid: {
                        display: false
                      },
                      ticks: {
                        font: {
                          family: "'Inter', sans-serif",
                          size: 10
                        }
                      }
                    }
                  }
                },
                height: '280px' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>