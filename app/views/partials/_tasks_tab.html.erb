<div class="card mb-4">
  <div class="card-header">
    <h3>All Tasks</h3>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Title</th>
            <th>Type</th>
            <th>Status</th>
            <th>Progress</th>
            <th>Deadline</th>
            <th>Project</th>
            <th>Assignee</th>
            <th>Company</th>
            <th>Created At</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <tr>
              <td><%= task.title %></td>
              <td><span class="badge bg-secondary"><%= task.task_type %></span></td>
              <td><span class="badge bg-info"><%= task.task_status.gsub('_', ' ') %></span></td>
              <td>
                <div class="progress" style="min-width: 80px;">
                  <div class="progress-bar" role="progressbar" 
                       style="width: <%= task.progress.gsub('%', '') %>%" 
                       aria-valuenow="<%= task.progress.gsub('%', '') %>" 
                       aria-valuemin="0" aria-valuemax="100">
                    <%= task.progress %>
                  </div>
                </div>
              </td>
              <td><%= task.estimated_deadline&.strftime('%b %d, %Y') || 'N/A' %></td>
              <td><%= task.project.title %></td>
              <td><%= task.assigned_user.username %></td>
              <td><%= task.project.company.name %></td>
              <td><%= task.created_at.strftime('%b %d, %Y') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Task Charts -->
<div class="row">
  <div class="col-md-4">
    <div class="card mb-4">
      <div class="card-header">
        <h4>Task Types</h4>
      </div>
      <div class="card-body">
        <%= pie_chart @task_type_chart_data %>
      </div>
    </div>
  </div>
  
  <div class="col-md-4">
    <div class="card mb-4">
      <div class="card-header">
        <h4>Task Status</h4>
      </div>
      <div class="card-body">
        <%= column_chart @task_status_chart_data %>
      </div>
    </div>
  </div>
  
  <div class="col-md-4">
    <div class="card mb-4">
      <div class="card-header">
        <h4>Task Progress</h4>
      </div>
      <div class="card-body">
        <%= bar_chart @task_progress_chart_data %>
      </div>
    </div>
  </div>
</div>