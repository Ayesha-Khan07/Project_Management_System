<!-- app/views/tasks/show.html.erb -->
<div class="max-w-3xl mx-auto py-8 px-4">
  <h1 class="text-2xl font-bold mb-4"><%= @task.title %></h1>
  <p class="mb-2"><strong>Project:</strong> <%= link_to @task.project.title, project_path(@task.project) %></p>
  <p class="mb-2"><strong>Assigned to:</strong> <%= @task.assigned_user.username %></p>
  <p class="mb-2"><strong>Type:</strong> <%= @task.task_type.humanize %></p>
  <p class="mb-2"><strong>Status:</strong> <%= @task.task_status.humanize %></p>
  <p class="mb-2"><strong>Progress:</strong> <%= @task.progress.gsub("_percent","%") %></p>
  <p class="mb-2"><strong>Estimated Deadline:</strong> <%= @task.estimated_deadline %></p>
  <div class="mt-4">
    <strong>Description:</strong>
    <p><%= @task.description %></p>
  </div>
</div>
