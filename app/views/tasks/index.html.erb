<div class="max-w-7xl mx-auto py-8 px-4">

  <h1 class="text-2xl font-bold mb-6 text-gray-800">
    Tasks for <span class="text-3xl text-teal-600"> <%= @project.title %> </span>
  </h1>

  <!-- Kanban columns container -->
  <div class="flex space-x-4 h-[600px]">

    <% ['to_do', 'in_progress', 'to_verify', 'done'].each do |status| %>
      <div class="flex-1 p-4 rounded-lg shadow-sm flex flex-col bg-teal-100">
        <!-- Column header -->
        <h2 class="text-xl font-semibold text-gray-700 mb-4 text-center">
          <%= status.humanize %>
        </h2>

        <!-- Tasks container: scrollable if overflow -->
        <div class="flex-1 overflow-y-auto space-y-4">
          <% @project.tasks.where(task_status: status).each do |task| %>
            <%= render partial: "partials/task_card", locals: { task: task, project: @project } %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>
