<!-- app/views/tasks/new.html.erb -->
<div class="max-w-3xl mx-auto py-8 px-4">
  <h1 class="text-2xl font-bold mb-6">Create Task for <%= @project.title %></h1>

  <%= form_with(model: [@project, @task]) do |f| %>
    <div class="mb-4">
      <%= f.label :title, class: "block font-semibold mb-1" %>
      <%= f.text_field :title, class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :description, class: "block font-semibold mb-1" %>
      <%= f.text_area :description, rows: 4, class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :task_type, class: "block font-semibold mb-1" %>
      <%= f.select :task_type, Task.task_types.keys.map { |k| [k.humanize, k] }, {}, class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :status, class: "block font-semibold mb-1" %>
      <%= f.select :task_status, Task.task_statuses.keys.map { |k| [k.humanize, k] }, {}, class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :progress, class: "block font-semibold mb-1" %>
      <%= f.select :progress, Task.progresses.keys.map { |k| [k.gsub("_percent","%"), k] }, {}, class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :estimated_deadline, class: "block font-semibold mb-1" %>
      <%= f.date_field :estimated_deadline, class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :assigned_user_id, "Assign to Employee", class: "block font-semibold mb-1" %>
      <%= f.select :assigned_user_id, @employees.map { |u| [u.username, u.id] }, {}, class: "w-full border rounded px-3 py-2" %>
    </div>

    <div>
      <%= f.submit "Create Task", class: "bg-teal-600 text-white px-4 py-2 rounded hover:bg-teal-700" %>
    </div>
  <% end %>
</div>
